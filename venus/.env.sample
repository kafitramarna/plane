# VenusVerse plane env — consolidated (upstream splits into root + apps/api/.env).
# Prod lives at /opt/apps/plane/.env on the VPS (rsync excludes .env*).

DEBUG=0
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=60/minute
HARD_DELETE_AFTER_DAYS=60

# --- domain (single origin, path-routed by the caddy proxy)
WEB_URL=https://plane.129-225-0-136.nip.io
APP_BASE_URL=https://plane.129-225-0-136.nip.io
APP_BASE_PATH=
ADMIN_BASE_URL=https://plane.129-225-0-136.nip.io
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=https://plane.129-225-0-136.nip.io
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=https://plane.129-225-0-136.nip.io
LIVE_BASE_PATH=/live
CORS_ALLOWED_ORIGINS=https://plane.129-225-0-136.nip.io
# vite build args (baked into the frontend images at build time)
VITE_API_BASE_URL=https://plane.129-225-0-136.nip.io
VITE_WEB_BASE_URL=https://plane.129-225-0-136.nip.io
VITE_ADMIN_BASE_URL=https://plane.129-225-0-136.nip.io
VITE_ADMIN_BASE_PATH=/god-mode
VITE_SPACE_BASE_URL=https://plane.129-225-0-136.nip.io
VITE_SPACE_BASE_PATH=/spaces
VITE_LIVE_BASE_URL=https://plane.129-225-0-136.nip.io
VITE_LIVE_BASE_PATH=/live

# --- postgres
POSTGRES_USER=plane
POSTGRES_PASSWORD=
POSTGRES_HOST=plane-db
POSTGRES_PORT=5432
POSTGRES_DB=plane
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:CHANGE_ME@plane-db:5432/plane

# --- redis / mq
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=plane

# --- object storage (bundled minio)
USE_MINIO=1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

# --- proxy (NPM terminates TLS; caddy listens plain :80)
SITE_ADDRESS=:80
LISTEN_HTTP_PORT=3030
TRUSTED_PROXIES=0.0.0.0/0
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=

# --- auth: VenusVerse SSO (custom provider, confidential client "plane")
IS_VENUS_ENABLED=1
VENUS_CLIENT_ID=plane
VENUS_CLIENT_SECRET=
VENUS_HOST=https://sso.129-225-0-136.nip.io
ENABLE_SIGNUP=1
